# 复制为 backend/.env，密钥仅在后端读取；不要提交此文件的真实配置。
# 默认是空的项目文档知识库；在网页上传 Markdown 即可，不需要修改资料配置。
# PRODUCT_CONFIG 仅用于可选的独立资料配置，正常使用无需填写。
# DATA_DIR=data/runtime/knowledge-base
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_REVISION=7999e1d3359715c523056ef9478215996d62a620
# 可改成已经下载的模型目录；首次需要下载时设为 false。
EMBEDDING_LOCAL_ONLY=true
EMBEDDING_DEVICE=cpu
CONTEXT_BUDGET=4000
UPLOAD_MAX_BYTES=1048576
